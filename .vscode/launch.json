  "configurations": [
    {
      // just for windows
      "name": "CUDA C++: Launch",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "preLaunchTask": "nvcc Generate Executable",
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "CUDA C++: Attach",
      "type": "cuda-gdb",
      "request": "attach"
    }
  ]
}
